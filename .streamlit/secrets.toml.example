# LocalAgentReady secrets template.
#
# Local dev: copy this to `.streamlit/secrets.toml` and fill in real values.
# Streamlit Community Cloud: paste the same keys into the app's
#   Settings → Secrets  (do NOT commit real secrets to git).
#
# EVERYTHING here is optional and fails soft: with a key missing, that one
# feature is quietly disabled and the rest of the app runs normally.

# ---- Owner-only full-report download (#6) ----
# Visit the app as  https://your-app-url/?admin=<this value>  to reveal the
# real PDF download and owner diagnostics. Leave unset and the button is
# hidden from everyone (including you).
ADMIN_TOKEN = "choose-a-long-random-string"

# ---- $10 payment (#3) ----
# A Stripe Payment Link (Stripe Dashboard → Payment links). The scanned
# domain is appended as client_reference_id so you can match a payment to the
# site it's for.
STRIPE_PAYMENT_LINK = "https://buy.stripe.com/xxxxxxxx"

# ---- Lead email notifications (#4) via Resend ----
RESEND_API_KEY = "re_xxxxxxxx"
LEAD_NOTIFY_TO = "rex@liftlogic.com"          # where lead alerts are sent
# Until you verify a sending domain in Resend, the sandbox sender below only
# delivers to the email on your Resend account (fine for alerts to yourself).
RESEND_FROM = "LocalAgentReady <onboarding@resend.dev>"

# ---- Adaptive benchmark + durable lead log (#1) via Google Sheets ----
# 1. Create a Google Cloud service account, enable the Google Sheets API,
#    download its JSON key.
# 2. Create a spreadsheet; share it with the service account's client_email
#    as an Editor. Put its id (the long token in the sheet URL) below.
# 3. Paste the JSON key fields into the [gcp_service_account] table below.
SHEET_ID = "your-google-sheet-id"

[gcp_service_account]
type = "service_account"
project_id = "your-project-id"
private_key_id = "xxxx"
private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
client_email = "your-sa@your-project-id.iam.gserviceaccount.com"
client_id = "xxxx"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "https://www.googleapis.com/robot/v1/metadata/x509/your-sa%40your-project-id.iam.gserviceaccount.com"
